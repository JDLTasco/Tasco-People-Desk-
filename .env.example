# Local development only. Copy to .env and fill in real local values --
# .env is gitignored and never committed (build spec §0.1.8: no secrets in
# the repo). In Azure, these map to Key Vault secrets via managed identity,
# not App Service application settings (see §2, §7's Bicep stage).

# Superuser/migration connection -- used by `prisma migrate` and `prisma db seed`.
# Local Docker Postgres only; never the app's own runtime connection.
DATABASE_URL="postgresql://postgres:changeme-local-only@localhost:5433/tasco_people_desk?schema=public"

# Application runtime connection -- a separate, least-privilege Postgres
# role (app_role) created by prisma/migrations/*_audit_log_grants. This is
# the connection the Next.js app actually uses (see lib/prisma.ts); it
# cannot UPDATE or DELETE audit_log, enforced at the database (§5).
APP_DATABASE_URL="postgresql://app_role:changeme-local-only@localhost:5433/tasco_people_desk?schema=public"

# Passwords for docker-compose's local Postgres container and the
# post-migration app_role password-set step (scripts/db-bootstrap-local.sh).
# Local dev only -- production auth is Entra ID / managed identity, not a
# password (§2, §6).
POSTGRES_SUPERUSER_PASSWORD=changeme-local-only
APP_ROLE_PASSWORD=changeme-local-only

# --- Auth (Stage 2, §6) ---

# NextAuth's own session encryption key. Generate locally with
# `openssl rand -base64 32` (or Node: require('crypto').randomBytes(32).toString('base64')).
# In Azure this is a Key Vault secret, never an App Service setting (§0.1.8).
NEXTAUTH_SECRET=
# Port 3002, not Next.js's default 3000 -- this machine already runs other
# Tasco projects' dev servers on 3000/3001 (see package.json's "dev" script,
# pinned to -p 3002 for the same reason). Must match exactly: NextAuth uses
# this for post-sign-in redirects, and a mismatch silently sends the
# browser to whatever else happens to be listening on the wrong port.
NEXTAUTH_URL=http://localhost:3002

# §14 item 1 (Entra app registration) hasn't happened yet -- leave these
# blank. lib/auth.ts only registers the real Azure AD provider when all
# three are set; until then, sign-in falls back to the dev-mock provider
# (Stages 1-3 only, never available in a production build).
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Mirrors AZURE_AD_TENANT_ID for the client-side Entra logout redirect
# (components/SignOutButton.tsx) -- tenant ID isn't secret, it's already
# visible in every OAuth redirect URL.
NEXT_PUBLIC_AZURE_AD_TENANT_ID=

# §14 item 4's real Entra security groups (HR-Ticketing-Admins/-Leads/-Users)
# don't exist yet either -- leave these blank. lib/roles.ts's deriveRole()
# denies access (§3: "no group is denied access... not a 500") rather than
# crash while these are unset.
AZURE_AD_GROUP_ADMINS_ID=
AZURE_AD_GROUP_LEADS_ID=
AZURE_AD_GROUP_USERS_ID=

# --- Graph ingestion (Stage 4, §7) ---

# §14 item 0 (mailbox migration) hasn't happened -- there's no real shared
# mailbox to target yet. lib/graph/client.ts's isGraphConfigured() treats
# a blank value here the same as blank AZURE_AD_* above: real Graph calls
# stay inert, use /api/dev/mock-inbound-email to exercise ingestion instead.
HR_MAILBOX_ID=

# Shared secret Graph echoes back on every webhook notification (§7.1) --
# generate locally with `openssl rand -hex 32`. Real value is set when
# the subscription is actually created (Stage 7's Logic App or a manual
# one-off once §14 is done); a mismatch is rejected with HTTP 400, not
# processed.
GRAPH_WEBHOOK_CLIENT_STATE=

# Shared secret for POST /api/jobs/* (§12) -- generate locally with
# `openssl rand -hex 32`. A missing or invalid X-Job-Key returns 401.
# In Azure this is a Key Vault secret, never an App Service setting.
JOB_API_KEY=
